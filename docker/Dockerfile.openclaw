# Sandbox image for the OpenClaw agent harness (BENCH_SANDBOX_IMAGE).
# One image per harness so a CLI bump cannot invalidate another agent's A/B
# baseline. Credentials, workspace, and fixtures are mounted at run time by
# devops_bench/agents/sandbox.py, never baked in.

# openclaw 2026.9.3+ needs Node >=24.16; digest-pinned multi-arch manifest.
FROM node:24-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6

# pipefail so the piped build-time asserts fail on the producer's error.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Changing any pin below changes the agent under test; re-baseline after a bump.
ARG KUBECTL_VERSION=v1.35.9
ARG KUBECTL_SHA256_AMD64=3cfeaf80be482b435b0aa214aff6e0b2c312ee23c0ff20810c75517b6004c6eb
ARG KUBECTL_SHA256_ARM64=39c98bca82875d9a9ddfb6f3c5ab17c3f78ea0801230683e538a67d5c053308d
ARG HELM_VERSION=v3.22.0
ARG HELM_SHA256_AMD64=1e4ab49e429626cf6c6958d914248b78c9730803c2751b87627e171dc800e7bb
ARG HELM_SHA256_ARM64=f14e804dfee240f55525b667488fe9adca349e63e00c9af634c0beb1421ac310
# Must match the host oc pin in tf/modules/bastion/startup.sh (the harness
# refuses a skew); the plugin is a matched pair, bump both together.
ARG OPENCLAW_VERSION=2026.9.6
ARG ANTHROPIC_VERTEX_PROVIDER_VERSION=2026.9.6

# ripgrep and jq are what the agent's own search and JSON handling reach for.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        jq \
        ripgrep \
    && rm -rf /var/lib/apt/lists/*

# kubectl and helm, checksum-verified per arch; an arch with no pin fails the build.
RUN arch="$(dpkg --print-architecture)" \
    && case "${arch}" in \
        amd64) kubectl_sha="${KUBECTL_SHA256_AMD64}"; helm_sha="${HELM_SHA256_AMD64}" ;; \
        arm64) kubectl_sha="${KUBECTL_SHA256_ARM64}"; helm_sha="${HELM_SHA256_ARM64}" ;; \
        *) echo "no checksum pinned for ${arch}" >&2; exit 1 ;; \
    esac \
    && curl -fsSLO "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${arch}/kubectl" \
    && echo "${kubectl_sha}  kubectl" | sha256sum -c - \
    && install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl \
    && rm kubectl \
    && curl -fsSLo helm.tar.gz "https://get.helm.sh/helm-${HELM_VERSION}-linux-${arch}.tar.gz" \
    && echo "${helm_sha}  helm.tar.gz" | sha256sum -c - \
    && tar -xzf helm.tar.gz -C /tmp \
    && install -o root -g root -m 0755 "/tmp/linux-${arch}/helm" /usr/local/bin/helm \
    && rm -rf helm.tar.gz "/tmp/linux-${arch}"

RUN npm install -g "openclaw@${OPENCLAW_VERSION}" \
    && npm cache clean --force

# npm installs the bin as `openclaw`; the harness invokes it as `oc`.
RUN ln -s "$(command -v openclaw)" /usr/local/bin/oc

# anthropic-vertex (Claude on Vertex) is not a stock plugin. Install it into
# openclaw's global prefix so npm dedupes the openclaw peer (a nested copy would
# trip the symlink-escape guard), copy it into the stock extensions root where
# openclaw discovers plugins, then drop the npm copy. The trailing checks assert
# the dedupe held and the plugin is registered, enabled, and loaded.
RUN npm install -g "@openclaw/anthropic-vertex-provider@${ANTHROPIC_VERTEX_PROVIDER_VERSION}" \
    && src="$(npm root -g)/@openclaw/anthropic-vertex-provider" \
    && dest="$(npm root -g)/openclaw/dist/extensions/anthropic-vertex" \
    && mkdir -p "${dest}" \
    && cp -a "${src}/." "${dest}/" \
    && npm uninstall -g "@openclaw/anthropic-vertex-provider" \
    && npm cache clean --force \
    && [ ! -e "${dest}/node_modules/openclaw" ] && [ ! -L "${dest}/node_modules/openclaw" ] \
    && oc plugins list --json \
        | jq -e '.plugins[] | select(.id == "anthropic-vertex" and .enabled and .status == "loaded")' >/dev/null

# `oc --version` prints one line, `OpenClaw <ver> (<sha>)`; assert the exact pin.
RUN oc --version | grep -E "^OpenClaw ${OPENCLAW_VERSION} " >/dev/null

# /workspace, HOME, and uid:gid come from the sandbox wrapper at run time.
WORKDIR /workspace
